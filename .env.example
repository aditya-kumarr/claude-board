# Express API port
PORT=4000
# Vite dev server port
WEB_PORT=5173
# Absolute or repo-relative path overrides (optional)
AUTOMATION_DB_PATH=./data/board.db
AUTOMATION_LOG_DIR=./logs
# minimum level written: debug | info | warn | error
LOG_LEVEL=info

# --- Cloudflare Tunnel (see `bun run tunnel`) ---
# Stable hostname for the board, on a zone already in your Cloudflare account.
# Lock it down with a Cloudflare Access policy — the tunnel itself is not a boundary.
TUNNEL_HOSTNAME=board.yourdomain.com
# Named tunnel to create/reuse. Defaults to board-local.
TUNNEL_NAME=board-local
# Bind the API beyond loopback. Only needed to reach it over the LAN without the tunnel.
# HOST=0.0.0.0

# --- @claude mention watcher (see `bun run watch:mentions`) ---
# When you write @claude in a task comment it becomes a tracked request either way;
# this watcher is what makes one get handled without you opening a Claude session.
# It spawns a real `claude -p` run, so treat these as a permission boundary.
# Tools the unattended run may use. Board tools plus read-only file access by default;
# it can move a card and read this repo, but not edit files or reach other MCP servers.
MENTION_WATCH_ALLOWED_TOOLS=mcp__board Read Grep Glob
# How often to look for new requests, and how long one run may take.
MENTION_WATCH_INTERVAL_MS=5000
MENTION_WATCH_TIMEOUT_MS=600000
# Spawns per request before it gives up and says so in the card's thread.
MENTION_WATCH_MAX_ATTEMPTS=2
# Override the CLI, pin a model, or append flags (e.g. --max-turns 30).
# MENTION_WATCH_CLAUDE_BIN=claude
# MENTION_WATCH_MODEL=
# MENTION_WATCH_CLAUDE_ARGS=

# --- Outlook/Teams sync watcher (see `bun run watch:sync`) ---
# The Sync button only queues a request; this process runs it. Microsoft 365 access
# comes from your claude.ai connector — the same one an interactive session uses —
# so there is nothing extra to sign in to.
# Read tools only, listed individually: allowing the whole connector would also hand
# an unattended run outlook_send_mail. Widen at your own risk.
# SYNC_WATCH_ALLOWED_TOOLS=mcp__board mcp__claude_ai_Microsoft_365__get_me ...
# Prefix of the connector's tools, if yours is registered under another name.
# SYNC_WATCH_MS365_PREFIX=mcp__claude_ai_Microsoft_365
SYNC_WATCH_INTERVAL_MS=10000
SYNC_WATCH_TIMEOUT_MS=900000
# MENTION_WATCH_* equivalents for the spawned run.
# SYNC_WATCH_CLAUDE_BIN=claude
# SYNC_WATCH_MODEL=
# SYNC_WATCH_CLAUDE_ARGS=

# --- Draft-reply watcher (see `bun run watch:responses`) ---
# Every synced card carries draft replies: one to send now, one for when the work is
# done. Typing an instruction under a draft ("make it shorter") only queues the ask —
# this process is what rewrites the words.
# The board and nothing else. Rewriting a paragraph needs no file access and no
# Microsoft 365 connector, so the run gets neither, enforced with --strict-mcp-config.
# Nothing here sends anything: a reply is marked sent when you tell the board you sent it.
RESPONSE_WATCH_ALLOWED_TOOLS=mcp__board
RESPONSE_WATCH_INTERVAL_MS=5000
RESPONSE_WATCH_TIMEOUT_MS=300000
# Spawns per change before it fails with the reason shown on the draft.
RESPONSE_WATCH_MAX_ATTEMPTS=2
# RESPONSE_WATCH_CLAUDE_BIN=claude
# RESPONSE_WATCH_MODEL=
# RESPONSE_WATCH_CLAUDE_ARGS=

# --- Board intake watcher (see `bun run watch:intake`) ---
# Each board has a chat you paste raw material into — a CSV export, notes from a call,
# a screenshot of a whiteboard — and this process is what turns it into cards.
# The allowlist is computed PER MESSAGE, not once here: text you paste (and text files
# you attach) is decoded at upload and travels inline in the prompt, so a pasted CSV
# gives the run these tools and no file access at all.
INTAKE_WATCH_ALLOWED_TOOLS=mcp__board
# `Read` is added on top, for one run only, when that message has a screenshot or a PDF
# that has to be opened. Set false to withhold it: a run then reports that it could not
# read the attachment rather than inventing what it said.
INTAKE_WATCH_ALLOW_FILE_READS=true
# Where attachments are written. Rows store paths relative to this.
AUTOMATION_INTAKE_DIR=./data/intake
INTAKE_WATCH_INTERVAL_MS=5000
INTAKE_WATCH_TIMEOUT_MS=600000
# Spawns per paste before it fails with the reason shown in the chat.
INTAKE_WATCH_MAX_ATTEMPTS=2
# INTAKE_WATCH_CLAUDE_BIN=claude
# INTAKE_WATCH_MODEL=
# INTAKE_WATCH_CLAUDE_ARGS=
